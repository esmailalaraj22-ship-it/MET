    {
      "name": "0. Health Check",
      "item": [
        {
          "name": "Health Check",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/../health"
            },
            "description": "Verify server is running"
          }
        }
      ]
    },
    {
      "name": "1. Authentication",
      "item": [
        {
          "name": "Admin Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) { pm.collectionVariables.set('adminToken', pm.response.json().data.accessToken); }"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"email\": \"admin1@edu.com\", \"password\": \"123456789\"}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login"
            }
          }
        },
        {
          "name": "Get Universities (for registration)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/universities"
            },
            "description": "Public — no auth required"
          }
        },
        {
          "name": "Register Student",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) { pm.collectionVariables.set('studentToken', pm.response.json().data.accessToken || ''); }"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"firstName\": \"\\u0645\\u062d\\u0645\\u062f\", \"secondName\": \"\\u0639\\u0628\\u062f\\u0627\\u0644\\u0644\\u0647\", \"familyName\": \"\\u0627\\u0644\\u0623\\u062d\\u0645\\u062f\\u064a\", \"email\": \"student_test@edu.com\", \"password\": \"pass123456\", \"confirmPassword\": \"pass123456\", \"universityId\": \"{{universityId}}\"}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/register"
            }
          }
        },
        {
          "name": "Student Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) { pm.collectionVariables.set('studentToken', pm.response.json().data.accessToken); }"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"email\": \"student_test@edu.com\", \"password\": \"pass123456\"}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login"
            }
          }
        },
        {
          "name": "Change Password",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"currentPassword\": \"123456789\", \"newPassword\": \"newPass123\", \"confirmNewPassword\": \"newPass123\"}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/change-password"
            }
          }
        },
        {
          "name": "Get Me",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/me"
            }
          }
        },
        {
          "name": "Refresh Token",
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{baseUrl}}/auth/refresh-token"
            },
            "description": "Uses httpOnly cookie automatically"
          }
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/logout"
            }
          }
        }
